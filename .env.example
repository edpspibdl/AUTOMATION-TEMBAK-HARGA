# ==============================================================================
# TEMPLATE KONFIGURASI KREDENSIAL LOGIN INDOGROSIR
# ==============================================================================
# Salin file ini menjadi .env lalu isi nilai di bawah sesuai akun Anda.

LOGIN_PERINTAH=KODE_TOKO_ATAU_BAGIAN
LOGIN_PASSWORD=PASSWORD_ANDA
LOGIN_USER_ID=USER_ID_ANDA

# ==============================================================================
# JADWAL OTOMATIS (SCHEDULER SERVICE)
# ==============================================================================
# Tentukan jam eksekusi otomatis dengan format HH:MM (24 jam).
# Bisa lebih dari satu jam, pisahkan dengan tanda koma.
# Contoh: SCHEDULE_JAM=06:00, 12:00, 18:00
SCHEDULE_JAM=06:00, 18:00

